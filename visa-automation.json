      "parameters": {
        "jsCode": "// Normalize Twilio WhatsApp payload (robust for n8n Webhook output)\n\nconst payload = $json.body ?? $json;\n\nconst from = payload.From || payload.from || '';\nconst user_phone = String(from.replace(/^whatsapp:\\+?/, ''));\n\nconst user_name = payload.ProfileName || payload.profileName || 'Unknown';\nconst text = payload.Body || payload.body || '';\n\nconst media_url = payload.MediaUrl0 || '';\n\nreturn {\n  user_phone,\n  user_name,\n  text,\n  media_url,\n};"
      },
